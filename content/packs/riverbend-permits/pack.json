 "explanations": {
  "decide": {
   "plain": "The office must decide within 20 business days.",
   "detail": "Section 1(b) of the current fictional ordinance."
  },
  "decide-draft": {
   "plain": "The office must decide within 10 business days.",
   "detail": "Section 1(b) of the fictional draft."
  },
  "grant": {
   "plain": "An insured, inspected applicant gets a permit.",
   "detail": "Section 2(a)."
  },
  "deny": {
   "plain": "An applicant who does not qualify is denied.",
   "detail": "Section 2(b)."
  },
  "deemed-grant": {
   "plain": "The deadline passed, so the application counts as granted.",
   "detail": "Section 1(c) of the fictional draft."
