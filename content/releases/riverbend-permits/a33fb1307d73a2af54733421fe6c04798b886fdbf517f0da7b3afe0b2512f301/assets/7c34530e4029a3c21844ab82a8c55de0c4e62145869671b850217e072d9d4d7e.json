"line","start":6},"text":"(a) A person who wishes to operate a mobile food vehicle shall apply to the Licensing Office.","versionId":"riverbend-ordinance-2027"},{"citation":"§ 1(b)","id":"s1.b","parentId":"s1","path":"1(b)","span":{"end":8,"kind":"line","start":7},"text":"(b) The Licensing Office shall decide a complete application within 20 business days after it is filed.\n","versionId":"riverbend-ordinance-2027"},{"citation":"§ 2","id":"s2","parentId":null,"path":"2","span":{"end":9,"kind":"line","start":9},"text":"Section 2. Eligibility.","versionId":"riverbend-ordinance-2027"},{"citation":"§ 2(a)","id":"s2.a","parentId":"s2","path":"2(a)","span":{"end":10,"kind":"line","start":10},"text":"(a) The Licensing Office shall grant a permit to an applicant who holds liability insurance and has passed a fire safety inspection.","versionId":"riverbend-ordinance-2027"},{"citation":"§ 2(b)","id":"s2.b","parentId":"s2","path":"2(b)","span":{"end":12,"kind":"line","start":11},"text":"(b) The Licensing Office shall deny a permit to an applicant who does not meet subsection (a).\n","versionId":"riverbend-ordinance-2027"},{"citation":"§ 3","id":"s3","parentId":null,"path":"3","span":{"end":13,"kind":"line","start":13},"text":"Section 3. Fees.","versionId":"riverbend-ordinance-2027"},{"citation":"§ 3(a)","id":"s3.a","parentId":"s3","path":"3(a)","span":{"end":15,"kind":"line","start":14},"text":"(a) A permit holder shall pay a permit fee of 250 dollars to the Town.\n","versionId":"riverbend-ordinance-2027"},{"citation":"§ 4","id":"s4","parentId":null,"path":"4","span":{"end":16,"kind":"line","start":16},"text":"Section 4. Appeals.","versionId":"riverbend-ordinance-2027"},{"citation":"§ 4(a)","id":"s4.a","parentId":"s4","path":"4(a)","span":{"end":18,"kind":"line","start":17},"text":"(a) An applicant whose application is denied may appeal to the Town Council within 30 days after the denial.\n","versionId":"riverbend-ordinance-2027"}],"retrievedAt":null,"rights":"Invented demonst